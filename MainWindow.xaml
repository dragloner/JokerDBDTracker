                                            <Button x:Name="AssignFx15BindButton" Grid.Column="2" Padding="6,4" FontSize="12" Tag="fx15" Content="Назначить" Click="AssignBindButton_Click"/>
                                        </Grid>

                                        <Button x:Name="ResetBindsButton"
                                                Margin="0,14,0,0"
                                                HorizontalAlignment="Left"
                                                Padding="20,7"
                                                MinHeight="34"
                                                FontSize="12"
                                                Content="Сбросить бинды по умолчанию"
                                                Click="ResetBindsButton_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card: Диагностика -->
                                <Border CornerRadius="12"
                                        Background="#70393A33"
                                        BorderBrush="#30EAE8E3"
                                        BorderThickness="1"
                                        Padding="16"
                                        Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Диагностика"
                                                   Foreground="#F2F0ED"
                                                   FontSize="14"
                                                   FontWeight="Bold"
/>

                                        <CheckBox x:Name="LoggingEnabledCheckBox"
                                                  Margin="0,12,0,0"
                                                  Foreground="#E5E3DE"
                                                  FontSize="14"
                                                  Content="Включить логирование ошибок"
                                                  Checked="LoggingEnabledCheckBox_Changed"
                                                  Unchecked="LoggingEnabledCheckBox_Changed"/>

                                        <Border Margin="0,12,0,0" Height="1" Background="#45463D"/>

                                        <TextBlock x:Name="LogViewerHeaderText"
                                                   Margin="0,12,0,0"
                                                   Text="Лог событий"
                                                   Foreground="#BDB7A9"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="LogViewerDescText"
                                                   Margin="0,4,0,0"
                                                   Text="Последние события приложения в реальном времени."
                                                   Foreground="#938973"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"/>
                                        <CheckBox x:Name="LogViewerErrorsOnlyCheckBox"
                                                  Margin="0,8,0,0"
                                                  Foreground="#E5E3DE"
                                                  FontSize="13"
                                                  Content="Только ошибки"
                                                  Checked="LogViewerFilter_Changed"
                                                  Unchecked="LogViewerFilter_Changed"/>
                                        <ListBox x:Name="LogViewerListBox"
                                                 Margin="0,6,0,0"
                                                 Height="180"
                                                 FontFamily="Consolas"
                                                 FontSize="12"
                                                 Background="#1B1B18"
                                                 Foreground="#E4E2DC"
                                                 BorderBrush="#33656759"
                                                 BorderThickness="1"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.ScrollUnit="Pixel"/>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="LogViewerCopyButton"
                                                    Grid.Column="0" MinHeight="34"
                                                    FontSize="12" Content="Копировать"
                                                    Click="LogViewerCopyButton_Click"/>
                                            <Button x:Name="LogViewerClearButton"
                                                    Grid.Column="2" MinHeight="34"
                                                    FontSize="12" Content="Очистить"
                                                    Click="LogViewerClearButton_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                    </Grid>
                </Grid>
            </Border>

            <TextBlock x:Name="StatusText" Grid.Row="8" Foreground="#DEDBD5" FontSize="12" TextWrapping="Wrap" Margin="4,4,0,0" Visibility="Collapsed"/>

            </Grid>
            <Grid x:Name="LoadingOverlay" Grid.ColumnSpan="3" Panel.ZIndex="1000" Margin="-20" Background="#12140F" ClipToBounds="True">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid Grid.Column="1" ClipToBounds="True">
                    <Image x:Name="LoadingBackgroundImage" Source="{StaticResource Brand.Medals}" Stretch="UniformToFill"/>
                    <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FF12140F" Offset="0"/><GradientStop Color="#2012140F" Offset="0.45"/><GradientStop Color="#3812140F" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                </Grid>
                <StackPanel Margin="64,40,30,40" VerticalAlignment="Center">
                    <Border Width="64" Height="3" Background="#E7BD72" HorizontalAlignment="Left" Margin="0,0,0,28"/>
                    <TextBlock Text="JOKER" FontSize="68" FontWeight="Black" Foreground="#F4F0E7"/>
                    <TextBlock Text="DBD" FontSize="68" FontWeight="Light" Foreground="#E7BD72" Margin="0,-18,0,28"/>
                    <TextBlock x:Name="LoadingTitleText" Text="Загрузка библиотеки" Foreground="#E8E7DB" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LoadingStatusText" Margin="0,10,0,0" Foreground="#A8AB9D" FontSize="14" TextWrapping="Wrap"/>
                    <ProgressBar x:Name="LoadingProgressBar" Style="{StaticResource Brand.Progress}" Margin="0,28,30,0" IsIndeterminate="True"/>
                    <TextBlock x:Name="LoadingProgressText" Margin="0,12,0,0" Foreground="#E7BD72" FontSize="13"/>
                </StackPanel>
                <TextBlock Text="JokerDBD Tracker" Foreground="#808577" FontSize="12" Margin="64,0,0,30" VerticalAlignment="Bottom"/>
            </Grid>
            <views:PsiIntroView x:Name="PsiIntro" Grid.ColumnSpan="3" Panel.ZIndex="1200" Margin="-20"/>
        </Grid>
    </Border>
</Window>
