<Window x:Class="JokerDBDTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:JokerDBDTracker.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="JokerDBD Tracker"
        Width="1580"
        Height="920"
        MinWidth="1220"
        MinHeight="640"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="CanResize"
        Icon="Assets/app.ico"
        Background="#10100E"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="8"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/MainWindow.Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="MainRootBorder" SizeChanged="BrandShell_SizeChanged"
            Margin="14"
            Padding="20"
            BorderBrush="#383C31" BorderThickness="1"
            Background="{StaticResource AppBackground}"
            CornerRadius="26"
            MouseLeftButtonDown="MainRootBorder_MouseLeftButtonDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="174"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.ColumnSpan="3" IsHitTestVisible="False" ClipToBounds="True">
                <Ellipse Width="720" Height="620" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-280,-220,0">
                    <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#24988F7A" Offset="0"/><GradientStop Color="#00988F7A" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="700" Height="760" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-260,0,0,-300">
                    <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#30887E69" Offset="0"/><GradientStop Color="#00887E69" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                </Ellipse>
            </Grid>
            <Border Grid.Column="0" CornerRadius="22" Background="#6431322B" BorderBrush="#28ECEBE7" BorderThickness="1" Padding="16,24">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <Border Width="66" Height="66" HorizontalAlignment="Left" CornerRadius="22" BorderBrush="#796344" BorderThickness="1">
                            <Border.Background><ImageBrush ImageSource="{StaticResource Brand.Portrait}" Stretch="UniformToFill"/></Border.Background>
                        </Border>
                        <TextBlock Text="JOKERDBD" Foreground="#F4F0E7" FontSize="19" FontWeight="Bold" Margin="0,18,0,0"/>
                        <TextBlock Text="Стримы и моменты" Foreground="#A9A99B" FontSize="11" Margin="0,5,0,30"/>
                        <Button x:Name="HomeNavButton" Tag="&#xE80F;" Style="{StaticResource TopNavButtonStyle}" Content="Главная" Click="HomeNavButton_Click"/>
                        <Button x:Name="FavoritesNavButton" Tag="&#xE734;" Style="{StaticResource TopNavButtonStyle}" Content="Избранное" Click="FavoritesNavButton_Click"/>
                        <Button x:Name="ProfileNavButton" Tag="&#xE77B;" Style="{StaticResource TopNavButtonStyle}" Content="Профиль" Click="ProfileNavButton_Click"/>
                        <Button x:Name="SettingsNavButton" Tag="&#xE713;" Style="{StaticResource TopNavButtonStyle}" Content="Настройки" Click="SettingsNavButton_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2">
                        <Border x:Name="SidebarPhoto" Height="126" CornerRadius="12" Margin="0,0,0,18" BorderBrush="#383B32" BorderThickness="1">
                            <Border.Background><ImageBrush ImageSource="{StaticResource Brand.Mask}" Stretch="UniformToFill" AlignmentY="Top"/></Border.Background>
                        </Border>
                        <Border Height="1" Background="#22EBE9E5" Margin="0,0,0,18"/>
                        <Button Content="Обновить каталог" x:Name="ReloadCatalogButton" FontSize="12" Padding="8,10" Click="ReloadCatalogButton_Click"/>
                        <TextBlock Text="by dragloner" Foreground="#746C5A" FontSize="10" TextAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="0"/>
                <RowDefinition Height="0"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="18"
                    CornerRadius="18"
                    Background="#A5282924"
                    BorderBrush="#35EAE8E3"
                    BorderThickness="1"
                    MouseLeftButtonDown="TopHeaderBorder_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="JokerDBD"
                                   Foreground="#FAF9F8"
                                   FontSize="23"
                                   FontWeight="ExtraBold"/>
                        <StackPanel Margin="3,-2,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="AppVersionText"
                                       Text="v1.4.11"
                                       Foreground="#C8C3B8"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="UpdateStatusText"
                                       Margin="12,0,0,0"
                                       Text="● Проверка обновлений..."
                                       Foreground="#E2C17A"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="UpdateProgramButton"
                                    Margin="12,0,0,0"
                                    Padding="10,4"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Content="Обновить программу"
                                    Visibility="Collapsed"
                                    Click="UpdateProgramButton_Click"/>
                            <Button x:Name="RestartProgramButton"
                                    Margin="8,0,0,0"
                                    Padding="10,4"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Content="Перезапустить программу"
                                    Visibility="Collapsed"
                                    Click="RestartProgramButton_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Margin="8,0,0,0"
                            CornerRadius="22"
                            BorderBrush="#35EAE8E3"
                            BorderThickness="1"
                            Background="#80282924"
                            Height="50"
                            VerticalAlignment="Center">
                        <Grid>
                            <TextBox x:Name="SearchBox"
                                     VerticalAlignment="Center"
                                     FontSize="15"
                                     FontWeight="SemiBold"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="SearchPlaceholderText" Text="Поиск стримов..."
                                    Foreground="#B8B2A3"
                                    FontWeight="Bold"
                                   FontSize="14"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Text, ElementName=SearchBox}" Value=""/>
                                                <Condition Binding="{Binding IsKeyboardFocused, ElementName=SearchBox}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        </Grid>
                    </Border>

                    <ComboBox x:Name="SortModeBox" FontSize="12"
                              Grid.Column="2"
                              Margin="8,0,0,0"
                              VerticalAlignment="Center"
                              SelectionChanged="SortModeBox_SelectionChanged"
                              SelectedIndex="1">
                        <ComboBoxItem x:Name="SortWatchedOldestItem" Tag="watched_oldest" Content="Сначала старые просмотры"/>
                        <ComboBoxItem x:Name="SortWatchedRecentItem" Tag="watched_recent" Content="Сначала новые просмотры"/>
                        <ComboBoxItem x:Name="SortChannelOrderItem" Tag="channel" Content="По порядку канала"/>
                    </ComboBox>

                    <StackPanel Grid.Column="4"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="MainMinimizeButton"
                                Style="{StaticResource WindowControlButtonStyle}"
                                Content="&#xE921;"
                                Click="MainMinimizeButton_Click"/>
                        <Button x:Name="MainWindowSizeButton"
                                Margin="8,0,0,0"
                                Style="{StaticResource WindowControlButtonStyle}"
                                Content="&#xE922;"
                                Click="MainWindowSizeButton_Click"/>
                        <Button x:Name="MainCloseButton"
                                Margin="8,0,0,0"
                                Style="{StaticResource WindowCloseButtonStyle}"
                                Content="&#xE8BB;"
                                Click="MainCloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="LibraryHero" Grid.Row="2" CornerRadius="20" BorderBrush="#454333" BorderThickness="1" Background="#20221B" ClipToBounds="True">
                <Grid x:Name="HeroLayout" MinHeight="190">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
                    <StackPanel x:Name="HeroContent" Margin="26,20,18,20" VerticalAlignment="Center">
                        <TextBlock x:Name="LibraryHeroTitle" Text="Библиотека стримов" Foreground="#F4F0E7" FontSize="30" FontWeight="SemiBold"/>
                        <TextBlock x:Name="HeroStreamTitle" Text="Выберите стрим для просмотра" Foreground="#BBBBAA" FontSize="13" Margin="0,8,0,16" TextTrimming="CharacterEllipsis" MaxHeight="36" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="HeroStartButton" Style="{StaticResource Brand.PrimaryButton}" IsEnabled="False" Click="HeroStartButton_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="▶" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock x:Name="HeroStartText" Text="Старт"/></StackPanel>
                            </Button>
                            <Button x:Name="TwitchWatchButton" Margin="16,0,0,0" Padding="14,10" FontSize="13" Click="TwitchWatchButton_Click">
                                <TextBlock x:Name="TwitchWatchButtonText" Text="Открыть Twitch"/>
                            </Button>
                            <TextBlock x:Name="HeroResumeText" Foreground="#A5A696" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Column="1" Margin="10,16,18,16" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border CornerRadius="13" BorderBrush="#756345" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><RotateTransform Angle="-4"/></Border.RenderTransform>
                            <Border.Background><ImageBrush ImageSource="{StaticResource Brand.Medals}" Stretch="UniformToFill" AlignmentY="Top"/></Border.Background>
                        </Border>
                        <Grid Grid.Column="2" Margin="0,5,0,5">
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="8"/><RowDefinition/></Grid.RowDefinitions>
                            <Border CornerRadius="12"><Border.Background><ImageBrush ImageSource="{StaticResource Brand.Smile}" Stretch="UniformToFill"/></Border.Background></Border>
                            <Border Grid.Row="2" CornerRadius="12"><Border.Background><ImageBrush ImageSource="{StaticResource Brand.Reaction}" Stretch="UniformToFill"/></Border.Background></Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <TabControl x:Name="TopTabControl" SelectedIndex="0"
                        Grid.Row="2"
                        Margin="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Visibility="Collapsed"
                        SelectionChanged="TopTabControl_SelectionChanged">
                <TabItem Header="Главная"/>
                <TabItem Header="Избранное"/>
                <TabItem Header="Профиль"/>
                <TabItem Header="Задания"/>
                <TabItem Header="Настройки"/>
            </TabControl>

            <Grid Grid.Row="4" Grid.RowSpan="3" Margin="0,12,0,0">
                <Grid.Resources>
                    <LinearGradientBrush x:Key="HomePanelBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#A3292A24" Offset="0"/>
                        <GradientStop Color="#A331322C" Offset="0.55"/>
                        <GradientStop Color="#A3363730" Offset="1"/>
                    </LinearGradientBrush>
                    <Style x:Key="HomeGlassPanelStyle" TargetType="Border">
                        <Setter Property="CornerRadius" Value="18"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="BorderBrush" Value="#30EAE8E3"/>
                        <Setter Property="Background" Value="{StaticResource HomePanelBackgroundBrush}"/>
                    </Style>
                    <Style x:Key="HomeInnerGlassStyle" TargetType="Border">
                        <Setter Property="CornerRadius" Value="14"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="BorderBrush" Value="#56574C"/>
                        <Setter Property="Background" Value="#A91B1B18"/>
                    </Style>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="RecommendationsColumn" Width="320"/>
                    <ColumnDefinition x:Name="MainColumnsSpacer" Width="16"/>
                    <ColumnDefinition x:Name="StreamsColumn" Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="HomeSummaryPanel"
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Padding="22,20"
                        Style="{StaticResource HomeGlassPanelStyle}">
                    <!-- Hidden compat elements for old code references -->
                    <Border.Resources>
                        <Style TargetType="TextBlock" x:Key="HiddenCompat">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>
                    </Border.Resources>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Streak stat -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="4,0,18,0">
                            <TextBlock x:Name="StatsStreakLabel"
                                       Text="Серия"
                                       Foreground="#B4AD9E"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="StatsStreakText"
                                       Text="0 дн."
                                       Foreground="#F0C070"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Margin="0,1,0,0"/>
                        </StackPanel>

                        <Rectangle Grid.Column="1" Width="1" Height="36" Fill="#4A4B41" VerticalAlignment="Center"/>

                        <!-- Hours stat -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="18,0">
                            <TextBlock x:Name="StatsTotalHoursLabel"
                                       Text="Часов просмотра"
                                       Foreground="#B4AD9E"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="StatsTotalHoursText"
                                       Text="0.0 ч"
                                       Foreground="#F1EFEC"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Margin="0,1,0,0"/>
                        </StackPanel>

                        <Rectangle Grid.Column="3" Width="1" Height="36" Fill="#4A4B41" VerticalAlignment="Center"/>

                        <!-- Stream count stat -->
                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="18,0">
                            <TextBlock x:Name="StatsStreamCountLabel"
                                       Text="Стримов в каталоге"
                                       Foreground="#B4AD9E"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="StatsStreamCountText"
                                       Text="0"
                                       Foreground="#F1EFEC"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Margin="0,1,0,0"/>
                        </StackPanel>

                        <Rectangle Grid.Column="5" Width="1" Height="36" Fill="#4A4B41" VerticalAlignment="Center"/>

                        <!-- XP / Level widget -->
                        <StackPanel Grid.Column="6" VerticalAlignment="Center" Margin="18,0,4,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="StatsLevelText"
                                           Text="Уровень 1"
                                           Foreground="#F1EFEC"
                                           FontSize="14"
                                           FontWeight="Bold"/>
                                <TextBlock x:Name="StatsXpText"
                                           Grid.Column="1"
                                           Text="0 / 0 XP"
                                           Foreground="#BBB4A6"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <ProgressBar x:Name="StatsXpBar"
                                         Margin="0,5,0,0"
                                         Height="6"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         Background="#32332D"
                                         BorderBrush="#4A4B41"
                                         BorderThickness="1"/>
                        </StackPanel>

                        <!-- Hidden compatibility elements -->
                        <TextBlock x:Name="HomeOverviewHeaderText" Visibility="Collapsed"/>
                        <TextBlock x:Name="HomeStatsText" Visibility="Collapsed"/>
                        <TextBlock x:Name="HomeHintText" Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <Border x:Name="FavoritesSummaryPanel"
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Padding="18,16"
                        Visibility="Collapsed"
                        Style="{StaticResource HomeGlassPanelStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,18,0">
                            <TextBlock x:Name="FavoritesOverviewHeaderText"
                                       Text="Избранное"
                                       Foreground="#F8F7F5"
                                       FontSize="24"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="FavoritesOverviewSubText"
                                       Margin="0,5,0,0"
                                       Text="Быстрый доступ к любимым стримам и сохранённым моментам."
                                       Foreground="#BBB5A7"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Padding="12,10"
                                        CornerRadius="14"
                                        Background="#B0272823"
                                        BorderBrush="#626456"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock x:Name="FavoritesFavoriteCountLabelText"
                                                   Text="Избранные стримы"
                                                   Foreground="#AAA290"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="FavoritesFavoriteCountValueText"
                                                   Text="0"
                                                   Foreground="#F8F8F7"
                                                   FontSize="28"
                                                   FontWeight="Bold"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Padding="12,10"
                                        CornerRadius="14"
                                        Background="#B02B2B26"
                                        BorderBrush="#79705D"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock x:Name="FavoritesMomentCountLabelText"
                                                   Text="Сохранённые моменты"
                                                   Foreground="#B2AA9A"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="FavoritesMomentCountValueText"
                                                   Text="0"
                                                   Foreground="#D2CEC4"
                                                   FontSize="28"
                                                   FontWeight="Bold"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4"
                                        Padding="12,10"
                                        CornerRadius="14"
                                        Background="#B030312A"
                                        BorderBrush="#857B66"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock x:Name="FavoritesResumeCountLabelText"
                                                   Text="Готовы к продолжению"
                                                   Foreground="#B9B2A4"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="FavoritesResumeCountValueText"
                                                   Text="0"
                                                   Foreground="#F5F5F3"
                                                   FontSize="28"
                                                   FontWeight="Bold"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="6"
                                        Padding="12,10"
                                        CornerRadius="14"
                                        Background="#B02E2F29"
                                        BorderBrush="#90866F"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock x:Name="FavoritesStreamsWithMomentsLabelText"
                                                   Text="Стримы с таймкодами"
                                                   Foreground="#C3BDB0"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="FavoritesStreamsWithMomentsValueText"
                                                   Text="0"
                                                   Foreground="#F6D998"
                                                   FontSize="28"
                                                   FontWeight="Bold"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Width="260"
                                    VerticalAlignment="Stretch">
                            <Button x:Name="ResumeFavoriteButton"
                                    Margin="0,0,0,8"
                                    Padding="12,10"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Content="Продолжить просмотр"
                                    Click="ResumeFavoriteButton_Click"/>
                            <Button x:Name="RandomFavoriteMomentButton"
                                    Padding="12,10"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Content="Случайный момент"
                                    Click="RandomFavoriteMomentButton_Click"/>
                            <Border Margin="0,12,0,0"
                                    Padding="12,10"
                                    CornerRadius="12"
                                    Background="#8F1D1E1A"
                                    BorderBrush="#58594E"
                                    BorderThickness="1">
                                <TextBlock x:Name="FavoritesSearchHintText"
                                           Text="Поиск сверху ищет и стримы, и таймкоды."
                                           Foreground="#BBB5A7"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="StreamsPanel"
                        Grid.Row="2"
                        Grid.Column="2"
                        Padding="14"
                        Style="{StaticResource HomeGlassPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Category filter chips row -->
                        <Border Grid.Row="2"
                                Padding="10,8"
                                Style="{StaticResource HomeInnerGlassStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="FilterAllButton"
                                            Content="Все"
                                            Tag="all"
                                            Padding="9,8"
                                            Margin="0,0,6,0"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Background="#5D5F52"
                                            BorderBrush="#B4AD9E"
                                            BorderThickness="1"
                                            Foreground="#ECEBE7"
                                            Click="CategoryFilterButton_Click"/>
                                    <Button x:Name="FilterFavoritesButton"
                                            Content="★ Избранное"
                                            Tag="favorites"
                                            Padding="9,8"
                                            Margin="0,0,6,0"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Background="#20201C"
                                            BorderBrush="#4A4B41"
                                            BorderThickness="1"
                                            Foreground="#E8C445"
                                            Click="CategoryFilterButton_Click"/>
                                    <Button x:Name="FilterTimecodesButton"
                                            Content="# Таймкоды"
                                            Tag="with_timecodes"
                                            Padding="9,8"
                                            Margin="0,0,0,0"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Background="#20201C"
                                            BorderBrush="#4A4B41"
                                            BorderThickness="1"
                                            Foreground="#CFCAC0"
                                            Click="CategoryFilterButton_Click"/>
                                </StackPanel>

                                <!-- Random stream button -->
                                <Button x:Name="RandomStreamButton"
                                        Grid.Column="1"
                                        Content="Случайный"
                                        Padding="10,5"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Background="#3A3B34"
                                        BorderBrush="#66685A"
                                        BorderThickness="1"
                                        Foreground="#CFCAC0"
                                        ToolTip="Открыть случайный стрим из текущего списка"
                                        Click="RandomStreamButton_Click"/>
                            </Grid>
                        </Border>

                        <!-- Stream count indicator -->
                        <TextBlock x:Name="StreamsCountLabel"
                                   Grid.Row="4"
                                   Foreground="#7B725F"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="4,0,0,0"
                                   Text="Загрузка..."/>

                        <!-- Video list -->
                        <Border Grid.Row="6"
                                Padding="8"
                                CornerRadius="14"
                                BorderBrush="#54554A"
                                BorderThickness="1"
                                Background="#991B1B18">
                            <ListBox x:Name="VideoList"
                                     Margin="0,2,6,2"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="True"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     ItemContainerStyle="{StaticResource VideoItemStyle}"
                                     SelectionChanged="VideoList_SelectionChanged">
                                <ListBox.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource UnifiedScrollBarStyle}"/>
                                </ListBox.Resources>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3"/>
                                                <ColumnDefinition Width="162"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="28"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Left accent bar — colored when in-progress -->
                                            <Border Grid.Column="0"
                                                    CornerRadius="2,0,0,2"
                                                    VerticalAlignment="Stretch">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#42433B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasResumePosition}" Value="True">
                                                                <Setter Property="Background" Value="#BBB4A6"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <!-- Thumbnail with overlaid badges -->
                                            <Border Grid.Column="1"
                                                    Width="162"
                                                    Height="92"
                                                    CornerRadius="8"
                                                    Background="#A42B2C26"
                                                    BorderBrush="#4A4B41"
                                                    BorderThickness="1"
                                                    ClipToBounds="True"
                                                    VerticalAlignment="Top">
                                                <Grid>
                                                    <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>
                                                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="40" Height="40" CornerRadius="20" Background="#E7BD72" IsHitTestVisible="False">
                                                        <Border.Style><Style TargetType="Border"><Setter Property="Opacity" Value="0"/>
                                                            <Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger></Style.Triggers>
                                                        </Style></Border.Style>
                                                        <TextBlock Text="▶" Foreground="#211B11" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                                    </Border>
                                                    <Border Background="#1510100E"/>

                                                    <!-- Progress bar at bottom of thumbnail -->
                                                    <Border VerticalAlignment="Bottom"
                                                            Height="3"
                                                            Background="#32332D"
                                                            Opacity="0.7">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasResumePosition}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <Rectangle VerticalAlignment="Bottom"
                                                               Height="3"
                                                               Fill="#CDC8BE"
                                                               HorizontalAlignment="Left"
                                                               Width="{Binding ResumeBarWidth}">
                                                        <Rectangle.Style>
                                                            <Style TargetType="Rectangle">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasResumePosition}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Rectangle.Style>
                                                    </Rectangle>

                                                    <!-- Badges overlay -->
                                                    <StackPanel Orientation="Horizontal"
                                                                VerticalAlignment="Top"
                                                                HorizontalAlignment="Left"
                                                                Margin="4,4,0,0">
                                                        <!-- Resume badge -->
                                                        <Border CornerRadius="4"
                                                                Padding="3,2"
                                                                Margin="0,0,3,0"
                                                                Background="#CC45473D"
                                                                BorderBrush="#55BBB5A7"
                                                                BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasResumePosition}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="▶"
                                                                       Foreground="#BBB5A7"
                                                                       FontSize="9"
                                                                       FontWeight="Bold"/>
                                                        </Border>
                                                        <!-- Favorite badge -->
                                                        <Border CornerRadius="4"
                                                                Padding="3,2"
                                                                Margin="0,0,3,0"
                                                                Background="#CC7A5A10"
                                                                BorderBrush="#55F0C04A"
                                                                BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="★"
                                                                       Foreground="#F0C04A"
                                                                       FontSize="9"
                                                                       FontWeight="Bold"/>
                                                        </Border>
                                                        <!-- Timecode badge -->
                                                        <Border CornerRadius="4"
                                                                Padding="3,2"
                                                                Background="#CC32332D"
                                                                BorderBrush="#55B0A999"
                                                                BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasTimecodes}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding TimecodeCount, StringFormat='🔖{0}'}"
                                                                       Foreground="#D3CFC6"
                                                                       FontSize="9"
                                                                       FontWeight="Bold"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Info text -->
                                            <StackPanel Grid.Column="3" Margin="0,2,4,0" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Title}"
                                                           Foreground="#F8F7F5"
                                                           FontWeight="Bold"
                                                           FontSize="17"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="68"/>
                                                <TextBlock Text="{Binding PublishedAtText}"
                                                           Foreground="#B4AD9E"
                                                           FontSize="13"
                                                           Margin="0,5,0,0"/>
                                                <TextBlock Text="{Binding LastViewedText}"
                                                           Foreground="#847A65"
                                                           FontSize="13"
                                                           Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding ResumeText}"
                                                           Foreground="#B5AE9F"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Queue button -->
                                            <Button Grid.Column="4"
                                                    Width="28"
                                                    Height="28"
                                                    Padding="0"
                                                    FontSize="13"
                                                    FontWeight="Bold"
                                                    Background="Transparent"
                                                    BorderBrush="#505147"
                                                    BorderThickness="1"
                                                    Foreground="#A9A18F"
                                                    Content="+"
                                                    Tag="{Binding VideoId}"
                                                    ToolTip="Добавить в очередь"
                                                    VerticalAlignment="Top"
                                                    Margin="0,2,0,0"
                                                    Click="AddToQueueButton_Click"/>

                                            <!-- Favorite button -->
                                            <Button Grid.Column="6"
                                                    Width="28"
                                                    Height="28"
                                                    Padding="0"
                                                    FontSize="14"
                                                    FontWeight="Bold"
                                                    Background="Transparent"
                                                    BorderBrush="#505147"
                                                    BorderThickness="1"
                                                    Foreground="#E8C445"
                                                    Content="{Binding FavoriteGlyph}"
                                                    Tag="{Binding VideoId}"
                                                    ToolTip="Переключить избранное"
                                                    VerticalAlignment="Top"
                                                    Margin="0,2,0,0"
                                                    Click="ToggleFavoriteButton_Click"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="RecommendationsPanel"
                        Grid.Row="2"
                        Grid.Column="0"
                        Padding="14"
                        Style="{StaticResource HomeGlassPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- Continue Watching -->
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>   <!-- Watch Queue -->
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>      <!-- Recommendations -->
                        </Grid.RowDefinitions>

                        <!-- ── Continue Watching ── -->
                        <Border x:Name="ContinueWatchingSection"
                                Grid.Row="0"
                                Background="#70393A33"
                                BorderBrush="#30EAE8E3"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12,10"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="ContinueWatchingHeaderText"
                                           Text="Продолжить просмотр"
                                           Foreground="#F2F0ED"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Margin="0,0,0,8"/>
                                <ListBox x:Name="ContinueWatchingList"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         ItemContainerStyle="{StaticResource VideoItemStyle}"
                                         SelectionChanged="ContinueWatchingList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="80" Height="46"
                                                        CornerRadius="6"
                                                        Background="#A42B2C26"
                                                        BorderBrush="#4A4B41"
                                                        BorderThickness="1"
                                                        ClipToBounds="True">
                                                    <Grid>
                                                        <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>
                                                        <!-- Resume bar -->
                                                        <Border VerticalAlignment="Bottom" Height="3" Background="#32332D" Opacity="0.7"/>
                                                        <Rectangle VerticalAlignment="Bottom"
                                                                   Height="3"
                                                                   Fill="#CDC8BE"
                                                                   HorizontalAlignment="Left"
                                                                   Width="{Binding ResumeBarWidthSmall}"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}"
                                                               Foreground="#F8F7F5"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               MaxHeight="36"/>
                                                    <TextBlock Text="{Binding ResumeText}"
                                                               Foreground="#CDC8BE"
                                                               FontSize="12"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <!-- ── Watch Queue ── -->
                        <Border x:Name="WatchQueueSection"
                                Grid.Row="2"
                                Background="#70393A33"
                                BorderBrush="#30EAE8E3"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12,10"
                                Visibility="Collapsed">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="WatchQueueHeaderText"
                                                   Text="Очередь"
                                                   Foreground="#F2F0ED"
                                                   FontSize="14"
                                                   FontWeight="Bold"/>
                                        <Border x:Name="WatchQueueBadge"
                                                Margin="6,0,0,0"
                                                Padding="5,1"
                                                CornerRadius="8"
                                                Background="#585A4E"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="WatchQueueCountText"
                                                       Text="0"
                                                       Foreground="#CFCAC0"
                                                       FontSize="12"
                                                       FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <Button x:Name="PlayQueueButton"
                                            Grid.Column="1"
                                            Content="▶ Смотреть всё"
                                            Padding="8,4"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Background="#404139"
                                            BorderBrush="#776E5B"
                                            BorderThickness="1"
                                            Foreground="#CFCAC0"
                                            Click="PlayQueueButton_Click"/>
                                </Grid>
                                <ListBox x:Name="WatchQueueList"
                                         MaxHeight="160"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ItemContainerStyle="{StaticResource VideoItemStyle}">
                                    <ListBox.Resources>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource UnifiedScrollBarStyle}"/>
                                    </ListBox.Resources>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="24"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}"
                                                           Foreground="#E2E0DA"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="36"
                                                           VerticalAlignment="Center"/>
                                                <Button Grid.Column="1"
                                                        Width="22"
                                                        Height="22"
                                                        Padding="0"
                                                        FontSize="12"
                                                        Background="Transparent"
                                                        BorderBrush="#505147"
                                                        BorderThickness="1"
                                                        Foreground="#A59D8B"
                                                        Content="✕"
                                                        Tag="{Binding VideoId}"
                                                        VerticalAlignment="Center"
                                                        Click="RemoveFromQueueButton_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <!-- ── Recommendations ── -->
                        <Border Grid.Row="4"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="RecommendationsHeaderText"
                                           Text="Рекомендации"
                                           Foreground="#F2F0ED"
                                           FontSize="14"
                                           FontWeight="Bold"/>
                                <Border Grid.Row="2"
                                        Padding="0"
                                        CornerRadius="10"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        Background="Transparent">
                                    <ListBox x:Name="RecommendationsList"
                                             Margin="0,2,4,2"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Foreground="#EAD0BF"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.CanContentScroll="True"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             ItemContainerStyle="{StaticResource VideoItemStyle}"
                                             SelectionChanged="RecommendationsList_SelectionChanged">
                                        <ListBox.Resources>
                                            <Style TargetType="ScrollBar" BasedOn="{StaticResource UnifiedScrollBarStyle}"/>
                                        </ListBox.Resources>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="76"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="76" Height="52"
                                                            CornerRadius="6"
                                                            Background="#A42B2C26"
                                                            BorderBrush="#4A4B41"
                                                            BorderThickness="1"
                                                            ClipToBounds="True"
                                                            VerticalAlignment="Top">
                                                        <Grid>
                                                            <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>
                                                            <Border Background="#1510100E"/>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="2" Margin="0,0,2,0">
                                                        <TextBlock Text="{Binding Title}"
                                                                   Foreground="#F8F7F5"
                                                                   FontWeight="Bold"
                                                                   FontSize="13"
                                                                   TextWrapping="Wrap"
                                                                   MaxHeight="48"/>
                                                        <TextBlock Text="{Binding PublishedAtText}" TextTrimming="CharacterEllipsis"
                                                                   Foreground="#A5A592"
                                                                   FontSize="12"
                                                                   Margin="0,3,0,0"/>
                                                        <TextBlock Text="{Binding LastViewedText}" TextTrimming="CharacterEllipsis"
                                                                   Foreground="#A5A592"
                                                                   FontSize="12"
                                                                   Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Favorites: Saved clips panel (shown in place of Recommendations when Favorites tab is active) -->
                <Border x:Name="FavoritesClipsPanel"
                        Grid.Row="2"
                        Grid.Column="0"
                        Padding="14"
                        Visibility="Collapsed"
                        Style="{StaticResource HomeGlassPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="FavoritesClipsHeaderText"
                                       Text="Сохранённые клипы"
                                       Foreground="#FAF9F8"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="FavoritesClipsSubtitleText"
                                       Margin="0,24,0,0"
                                       Foreground="#B1A999"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Top"/>
                            <TextBlock x:Name="FavoritesClipsCountText"
                                       Grid.Column="1"
                                       Foreground="#7B725F"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </Grid>

                        <!-- Clips list -->
                        <Border Grid.Row="2"
                                Padding="6"
                                CornerRadius="14"
                                BorderBrush="#54554A"
                                BorderThickness="1"
                                Background="#991B1B18">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <Border Width="180" Height="120" CornerRadius="14" HorizontalAlignment="Center" Margin="0,22,0,12" Visibility="{Binding Visibility, ElementName=FavoritesClipsEmptyText}">
                                        <Border.Background><ImageBrush ImageSource="{StaticResource Brand.Smile}" Stretch="UniformToFill"/></Border.Background>
                                    </Border>
                                    <TextBlock x:Name="FavoritesClipsEmptyText"
                                               Text="Нет сохранённых клипов. Открой видео и нажми M."
                                               Foreground="#B6B0A1"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               Margin="4,4,4,0"
                                               Visibility="Collapsed"/>
                                    <ItemsControl x:Name="FavoritesClipsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,6"
                                                        CornerRadius="9"
                                                        Background="#B0252621"
                                                        BorderBrush="#33847B66"
                                                        BorderThickness="1"
                                                        ClipToBounds="True">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Thumbnail with time badge -->
                                                        <Grid Width="80" Height="48" Background="#161614">
                                                            <Image Source="{Binding ThumbnailUrl}"
                                                                   Stretch="UniformToFill"/>
                                                            <Border VerticalAlignment="Bottom"
                                                                    HorizontalAlignment="Right"
                                                                    Margin="0,0,3,3"
                                                                    Padding="3,1"
                                                                    Background="#CC000000"
                                                                    CornerRadius="3">
                                                                <TextBlock Text="{Binding TimeFormatted}"
                                                                           Foreground="#F8F8F7"
                                                                           FontSize="9"
                                                                           FontWeight="Bold"/>
                                                            </Border>
                                                        </Grid>

                                                        <!-- Clip info -->
                                                        <Grid Grid.Column="1" Margin="7,5,6,5">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <TextBlock Grid.Row="0"
                                                                       Text="{Binding VideoTitle}"
                                                                       FontSize="10"
                                                                       Foreground="#968C77"
                                                                       TextTrimming="CharacterEllipsis"/>

                                                            <TextBlock Grid.Row="1"
                                                                       Text="{Binding Label}"
                                                                       Foreground="#FAF9F8"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"/>

                                                            <!-- Action row -->
                                                            <StackPanel Grid.Row="2"
                                                                        Orientation="Horizontal"
                                                                        HorizontalAlignment="Right"
                                                                        Margin="0,4,0,0">
                                                                <Button Content="▶"
                                                                        Padding="5,2"
                                                                        FontSize="10"
                                                                        Margin="0,0,4,0"
                                                                        Tag="{Binding Id}"
                                                                        ToolTip="Открыть видео в этом месте"
                                                                        Click="FavoritesClipOpenButton_Click"/>
                                                                <Button Content="✕"
                                                                        Padding="5,2"
                                                                        FontSize="10"
                                                                        Tag="{Binding Id}"
                                                                        Click="FavoritesClipDeleteButton_Click"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="ProfilePanel"
                    Grid.Row="4"
                    Grid.RowSpan="3"
                    Padding="14"
                    CornerRadius="18"
                    Background="#A5282924"
                    BorderBrush="#35EAE8E3"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#70393A33" BorderBrush="#30EAE8E3" BorderThickness="1" CornerRadius="14" Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Prestige circle -->
                            <Grid Width="80" Height="80" VerticalAlignment="Center">
                                <Border Background="#484A40"
                                        BorderBrush="#978E79"
                                        BorderThickness="2"
                                        CornerRadius="40"
                                        ClipToBounds="True">
                                    <Image x:Name="PrestigeIconImage" Stretch="UniformToFill"/>
                                </Border>
                                <TextBlock x:Name="PrestigeValueText"
                                           FontSize="26"
                                           FontWeight="ExtraBold"
                                           Foreground="#FFF5D8"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Stats -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ProfileHeaderText" Text="Профиль" Foreground="#F2F0ED" FontWeight="Bold" FontSize="22"/>
                                    <TextBlock x:Name="ProfileLevelText" Grid.Column="1" Margin="14,0,0,0" Foreground="#DDDAD3" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="ProfileXpText" Foreground="#B1A999" FontSize="14" Margin="0,4,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock x:Name="ProfileStreakText" Foreground="#F0C070" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock x:Name="ProfileTodayText" Foreground="#BAB4A6" FontSize="14" Margin="14,0,0,0"/>
                                    <TextBlock x:Name="ProfileHoursText" Foreground="#A69E8C" FontSize="14" Margin="14,0,0,0"/>
                                </StackPanel>
                                <ProgressBar x:Name="ProfileXpProgress" Margin="0,10,0,0" Height="16" Minimum="0"/>
                            </StackPanel>

                            <!-- Quests button -->
                            <Button x:Name="OpenQuestsButton"
                                    Grid.Column="3"
                                    Background="#585A4E"
                                    Foreground="#F5F4F2"
                                    Padding="18,10"
                                    MinHeight="40"
                                    VerticalAlignment="Center"
                                    Content="Открыть задания"
                                    Click="OpenQuestsButton_Click"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#70393A33" BorderBrush="#30EAE8E3" BorderThickness="1" CornerRadius="14" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="AchievementsHeaderText" Text="Достижения" Foreground="#F2F0ED" FontWeight="Bold" FontSize="18"/>
                                <ListBox x:Name="AchievementsList"
                                          Grid.Row="1"
                                          Margin="0,12,0,0"
                                          Background="Transparent"
                                          Foreground="#EAD0BF"
                                          BorderThickness="0"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.CanContentScroll="True"
                                           VirtualizingPanel.IsVirtualizing="True"
                                           VirtualizingPanel.VirtualizationMode="Recycling"
                                           ItemContainerStyle="{StaticResource AchievementItemStyle}"
                                           ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.Resources>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource UnifiedScrollBarStyle}"/>
                                    </ListBox.Resources>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Width="40"
                                                        Height="40"
                                                        CornerRadius="20"
                                                        BorderBrush="#B1A999"
                                                        BorderThickness="1"
                                                        Background="#C655574B">
                                                    <TextBlock x:Name="AchievementGlyph"
                                                               Text="○"
                                                               FontSize="24"
                                                               FontWeight="Bold"
                                                               Foreground="#E9E7E2"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding Title}"
                                                               Foreground="#F9F9F8"
                                                               FontWeight="Bold"
                                                               FontSize="20"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Description}"
                                                               Foreground="#E4E2DD"
                                                               FontSize="15"
                                                               Margin="0,2,0,0"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                                    <Setter TargetName="AchievementGlyph" Property="Text" Value="✔"/>
                                                    <Setter TargetName="AchievementGlyph" Property="Foreground" Value="#82EDB9"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Background="#70393A33" BorderBrush="#30EAE8E3" BorderThickness="1" CornerRadius="14" Padding="14">
                            <StackPanel>
                                <TextBlock x:Name="RecentStreamsHeaderText"
                                           Text="Последние просмотренные"
                                           Foreground="#F2F0ED"
                                           FontWeight="Bold"
                                           FontSize="18"/>
                                <ListBox x:Name="RecentStreamsList"
                                         Margin="0,8,0,0"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="#EAD0BF"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.CanContentScroll="True"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         ItemContainerStyle="{StaticResource VideoItemStyle}"
                                         SelectionChanged="RecentStreamsList_SelectionChanged">
                                    <ListBox.Resources>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource UnifiedScrollBarStyle}"/>
                                    </ListBox.Resources>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Width="120"
                                                        Height="68"
                                                        CornerRadius="8"
                                                        Background="#C34B4C42"
                                                        ClipToBounds="True"
                                                        VerticalAlignment="Top">
                                                    <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>
                                                </Border>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding Title}"
                                                               Foreground="#F9F9F8"
                                                               FontWeight="Bold"
                                                               FontSize="16"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding LastViewedText}"
                                                               Foreground="#DCD9D1"
                                                               FontSize="13"
                                                               Margin="0,3,0,0"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="QuestsPanel"
                    Grid.Row="4"
                    Grid.RowSpan="3"
                    Padding="14"
                    CornerRadius="18"
                    Background="#A5282924"
                    BorderBrush="#35EAE8E3"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="QuestsPageHeaderText"
                                       Text="Задания"
                                       Foreground="#F2F0ED"
                                       FontSize="22"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="QuestsSummaryText"
                                       Margin="0,4,0,0"
                                       Foreground="#928872"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="BackToProfileButton"
                                Grid.Column="1"
                                Padding="16,8"
                                MinHeight="36"
                                VerticalAlignment="Center"
                                Content="Назад в профиль"
                                Click="BackToProfileButton_Click"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#70393A33" BorderBrush="#30EAE8E3" BorderThickness="1" CornerRadius="14" Padding="14">
                            <StackPanel>
                                <TextBlock x:Name="QuestsDailyHeaderText" Text="Ежедневные задания" Foreground="#F2F0ED" FontWeight="Bold" FontSize="17"/>
                                <TextBlock x:Name="QuestsDailyResetText"
                                           Margin="0,4,0,0"
                                           Text="Обновление через: --:--:--"
                                           Foreground="#D4CFC6"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                                <ListBox x:Name="QuestsDailyList"
                                         Margin="0,12,0,0"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ItemContainerStyle="{StaticResource QuestItemStyle}">
                                    <ListBox.Resources>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource UnifiedScrollBarStyle}"/>
                                    </ListBox.Resources>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding StatusGlyph}" Foreground="{Binding StatusColor}" FontSize="16" VerticalAlignment="Top"/>
                                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Title}" Foreground="#FAFAF9" FontWeight="Bold" FontSize="16"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="#E7E4DF" FontSize="13" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding ProgressText}" Foreground="#D4D0C8" FontSize="13" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding RewardText}" Foreground="#9CE6B7" FontSize="13"/>
                                                    <Button Margin="0,6,0,0"
                                                            Height="32"
                                                            HorizontalAlignment="Left"
                                                            Style="{StaticResource ClaimQuestButtonStyle}"
                                                            Content="{Binding ClaimButtonText}"
                                                            Tag="{Binding ClaimKey}"
                                                            IsEnabled="{Binding IsClaimEnabled}"
                                                            Click="ClaimQuestButton_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#70393A33" BorderBrush="#30EAE8E3" BorderThickness="1" CornerRadius="14" Padding="14">
                            <StackPanel>
                                <TextBlock x:Name="QuestsWeeklyHeaderText" Text="Еженедельные задания" Foreground="#F2F0ED" FontWeight="Bold" FontSize="17"/>
                                <TextBlock x:Name="QuestsWeeklyResetText"
                                           Margin="0,4,0,0"
                                           Text="Обновление через: --:--:--"
                                           Foreground="#D4CFC6"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                                <ListBox x:Name="QuestsWeeklyList"
                                         Margin="0,12,0,0"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ItemContainerStyle="{StaticResource QuestItemStyle}">
                                    <ListBox.Resources>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource UnifiedScrollBarStyle}"/>
                                    </ListBox.Resources>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding StatusGlyph}" Foreground="{Binding StatusColor}" FontSize="16" VerticalAlignment="Top"/>
                                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Title}" Foreground="#FAFAF9" FontWeight="Bold" FontSize="16"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="#E7E4DF" FontSize="13" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding ProgressText}" Foreground="#D4D0C8" FontSize="13" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding RewardText}" Foreground="#9CE6B7" FontSize="13"/>
                                                    <Button Margin="0,6,0,0"
                                                            Height="32"
                                                            HorizontalAlignment="Left"
                                                            Style="{StaticResource ClaimQuestButtonStyle}"
                                                            Content="{Binding ClaimButtonText}"
                                                            Tag="{Binding ClaimKey}"
                                                            IsEnabled="{Binding IsClaimEnabled}"
                                                            Click="ClaimQuestButton_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="SettingsPanel"
                    Grid.Row="4"
                    Grid.RowSpan="3"
                    Padding="0"
                    CornerRadius="18"
                    Background="#A5282924"
                    BorderBrush="#35EAE8E3"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <Grid Margin="16,14,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="SettingsHeaderText"
                                   Grid.Row="0"
                                   Text="Настройки"
                                   Foreground="#FAF9F8"
                                   FontSize="26"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="SettingsSubtitleText"
                                   Grid.Row="1"
                                   Margin="0,2,0,0"
                                   Text="Персонализация и поведение приложения"
                                   Foreground="#BDB7A9"
                                   FontSize="13"/>
                        <TextBlock x:Name="SettingsCreatorText"
                                   Grid.Row="0"
                                   Grid.RowSpan="2"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   Text="dragloner"
                                   Foreground="#55CBC6BB"
                                   FontSize="9"
                                   FontWeight="SemiBold"/>
                    </Grid>

                    <!-- Two-column layout -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="370"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ═══ LEFT COLUMN ═══ -->
                        <ScrollViewer Grid.Column="0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>

                                <!-- Card: Интерфейс -->
                                <Border CornerRadius="12"
                                        Background="#70393A33"
                                        BorderBrush="#30EAE8E3"
                                        BorderThickness="1"
                                        Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Интерфейс"
                                                   Foreground="#F2F0ED"
                                                   FontSize="14"
                                                   FontWeight="Bold"
/>

                                        <TextBlock x:Name="LanguageLabelText"
                                                   Margin="0,14,0,0"
                                                   Text="Язык"
                                                   Foreground="#BDB7A9"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                        <ComboBox x:Name="LanguageComboBox"
                                                  Margin="0,5,0,0"
                                                  SelectionChanged="LanguageComboBox_SelectionChanged">
                                            <ComboBoxItem Tag="ru" Content="Русский"/>
                                            <ComboBoxItem Tag="en" Content="English"/>
                                        </ComboBox>

                                        <TextBlock x:Name="UiScaleLabelText"
                                                   Margin="0,14,0,0"
                                                   Text="Масштаб UI"
                                                   Foreground="#BDB7A9"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="54"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="UiScaleSlider"
                                                    VerticalAlignment="Center"
                                                    Minimum="0.85"
                                                    Maximum="1.35"
                                                    TickFrequency="0.05"
                                                    IsMoveToPointEnabled="True"
                                                    IsSnapToTickEnabled="False"
                                                    ValueChanged="UiScaleSlider_ValueChanged"/>
                                            <TextBlock x:Name="UiScaleValueText"
                                                       Grid.Column="1"
                                                       Margin="8,0,0,0"
                                                       Foreground="#EBE9E5"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Right"
                                                       Text="1.00x"/>
                                        </Grid>

                                        <CheckBox x:Name="AnimationsEnabledCheckBox"
                                                  Margin="0,12,0,0"
                                                  Foreground="#E5E3DE"
                                                  FontSize="14"
                                                  Content="Плавные анимации интерфейса"
                                                  Checked="AnimationsEnabledCheckBox_Changed"
                                                  Unchecked="AnimationsEnabledCheckBox_Changed"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card: Запуск и поведение -->
                                <Border CornerRadius="12"
                                        Background="#70393A33"
                                        BorderBrush="#30EAE8E3"
                                        BorderThickness="1"
                                        Padding="16"
                                        Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Запуск и поведение"
                                                   Foreground="#F2F0ED"
                                                   FontSize="14"
                                                   FontWeight="Bold"
/>

                                        <TextBlock x:Name="AutoStartLabelText"
                                                   Margin="0,14,0,0"
                                                   Text="Автозапуск"
                                                   Foreground="#BDB7A9"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                        <CheckBox x:Name="AutoStartCheckBox"
                                                  Margin="0,6,0,0"
                                                  Foreground="#E5E3DE"
                                                  FontSize="14"
                                                  Content="Запускать вместе с Windows"
                                                  Checked="AutoStartCheckBox_Changed"
                                                  Unchecked="AutoStartCheckBox_Changed"/>
                                        <CheckBox x:Name="AutoCheckUpdatesCheckBox"
                                                  Margin="0,9,0,0"
                                                  Foreground="#E5E3DE"
                                                  FontSize="14"
                                                  Content="Проверять обновления при запуске"
                                                  Checked="AutoCheckUpdatesCheckBox_Changed"
                                                  Unchecked="AutoCheckUpdatesCheckBox_Changed"/>

                                        <Border Margin="0,14,0,12" Height="1" Background="#45463D"/>

                                        <TextBlock x:Name="FullscreenBehaviorLabelText"
                                                   Text="Поведение fullscreen"
                                                   Foreground="#BDB7A9"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                        <ComboBox x:Name="FullscreenBehaviorComboBox"
                                                  Margin="0,5,0,0"
                                                  SelectionChanged="FullscreenBehaviorComboBox_SelectionChanged">
                                            <ComboBoxItem Tag="auto" Content="Авто: окно следует fullscreen плеера"/>
                                            <ComboBoxItem Tag="windowed" Content="Оставаться в оконном режиме"/>
                                        </ComboBox>
                                        <TextBlock x:Name="FullscreenBehaviorDescriptionText"
                                                   Margin="0,6,0,0"
                                                   Text="Auto: при fullscreen в YouTube окно плеера тоже развернется. Windowed: остаётся обычным."
                                                   Foreground="#938973"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card: Данные и кеш -->
                                <Border CornerRadius="12"
                                        Background="#70393A33"
                                        BorderBrush="#30EAE8E3"
                                        BorderThickness="1"
                                        Padding="16"
                                        Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="CacheLabelText"
                                                   Text="Данные и кеш"
                                                   Foreground="#F2F0ED"
                                                   FontSize="14"
                                                   FontWeight="Bold"
/>
                                        <TextBlock x:Name="CacheDescriptionText"
                                                   Margin="0,8,0,0"
                                                   Text="Очищает WebView2 профиль (YouTube данные) и временные обновления."
                                                   Foreground="#938973"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"/>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="ResetCacheButton"
                                                    Grid.Column="0"
                                                    MinHeight="36"
                                                    FontSize="13"
                                                    Content="Сбросить кеш"
                                                    Click="ResetCacheButton_Click"/>
                                            <Button x:Name="OpenLogFolderButton"
                                                    Grid.Column="2"
                                                    MinHeight="36"
                                                    FontSize="13"
                                                    Content="Открыть логи"
                                                    Click="OpenLogFolderButton_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- ═══ RIGHT COLUMN ═══ -->
                        <ScrollViewer Grid.Column="2"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>

                                <!-- Card: Плеер и бинды -->
                                <Border CornerRadius="12"
                                        Background="#70393A33"
                                        BorderBrush="#30EAE8E3"
                                        BorderThickness="1"
                                        Padding="16">
                                    <StackPanel>
                                        <TextBlock x:Name="BindsSectionTitleText"
                                                   Text="Бинды плеера"
                                                   Foreground="#F2F0ED"
                                                   FontSize="14"
                                                   FontWeight="Bold"/>
                                        <TextBlock x:Name="BindsSectionDescriptionText"
                                                   Margin="0,4,0,0"
                                                   Text="Клавиши для панели эффектов, всех 15 эффектов и саунд-эффектов."
                                                   Foreground="#938973"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"/>

                                        <!-- Capture hint + live status -->
                                        <Border Margin="0,10,0,0" Padding="10,7"
                                                Background="#1E1F1B" CornerRadius="8"
                                                BorderBrush="#4D4E44" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock x:Name="BindCaptureHelpText"
                                                           Text="Нажмите «Назначить», затем любую клавишу. Esc — отмена."
                                                           Foreground="#ADA695"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock x:Name="BindCaptureStatusText"
                                                           Text=""
                                                           Margin="0,3,0,0"
                                                           Foreground="#F4D89B"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Sound spam mode -->
                                        <Border Margin="0,14,0,0" Height="1" Background="#45463D"/>
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="SoundModeHeaderText"
                                                           Text="Режим звуковых эффектов"
                                                           Foreground="#E5E3DE"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock x:Name="SoundModeDescText"
                                                           Margin="0,3,0,0"
                                                           Text="Выкл — стоп при повторном нажатии. Вкл — спам до 8 звуков."
                                                           Foreground="#938973"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="SoundSpamModeToggle"
                                                      Grid.Column="1"
                                                      Margin="16,0,0,0"
                                                      VerticalAlignment="Center"
                                                      Foreground="#E5E3DE"
                                                      FontSize="13"
