<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:JokerDBDTracker">
    <!-- Shared surfaces keep the library and player in the same visual family. -->
    <SolidColorBrush x:Key="Brand.Ink" Color="#101211"/>
    <SolidColorBrush x:Key="Brand.Surface" Color="#1C1E1B"/>
    <SolidColorBrush x:Key="Brand.Line" Color="#383B32"/>
    <SolidColorBrush x:Key="Brand.Accent" Color="#E7BD72"/>
    <SolidColorBrush x:Key="Brand.Text" Color="#F4F0E7"/>
    <BitmapImage x:Key="Brand.Portrait" UriSource="/JokerDBDTracker;component/Assets/Brand/portrait.png" DecodePixelWidth="520"/>
    <BitmapImage x:Key="Brand.Smile" UriSource="/JokerDBDTracker;component/Assets/Brand/smile.png" DecodePixelWidth="400"/>
    <BitmapImage x:Key="Brand.Medals" UriSource="/JokerDBDTracker;component/Assets/Brand/medals.jpg" DecodePixelWidth="1000"/>
    <BitmapImage x:Key="Brand.Mask" UriSource="/JokerDBDTracker;component/Assets/Brand/mask.png" DecodePixelWidth="520"/>
    <BitmapImage x:Key="Brand.Reaction" UriSource="/JokerDBDTracker;component/Assets/Brand/reaction.png" DecodePixelWidth="320"/>

    <Style x:Key="Brand.Button" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Brand.Text}"/>
        <Setter Property="Background" Value="#292D26"/>
        <Setter Property="BorderBrush" Value="#454A3D"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="ButtonBody" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                        <Border x:Name="Plate" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11"/>
                        <Border x:Name="Highlight" Background="#18FFFFFF" CornerRadius="11" Opacity="0" IsHitTestVisible="False"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="BorderBrush" Value="#D9BF8F"/></Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="ui:UiAnimation.IsEnabled" Value="True"/>
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Highlight" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/>
                            </Storyboard></BeginStoryboard></MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Highlight" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                            </Storyboard></BeginStoryboard></MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Plate" Property="Opacity" Value="0.76"/></Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions><Condition Property="IsPressed" Value="True"/><Condition Property="ui:UiAnimation.IsEnabled" Value="True"/></MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ButtonBody" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.97" Duration="0:0:0.08"/>
                                <DoubleAnimation Storyboard.TargetName="ButtonBody" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.97" Duration="0:0:0.08"/>
                            </Storyboard></BeginStoryboard></MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ButtonBody" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.16"/>
                                <DoubleAnimation Storyboard.TargetName="ButtonBody" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.16"/>
                            </Storyboard></BeginStoryboard></MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Plate" Property="BorderBrush" Value="#FFE1A7"/><Setter TargetName="Plate" Property="BorderThickness" Value="2"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Brand.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Brand.Button}">
        <Setter Property="Foreground" Value="#211B11"/>
        <Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F3D59C" Offset="0"/><GradientStop Color="#DDAA56" Offset="1"/>
        </LinearGradientBrush></Setter.Value></Setter>
        <Setter Property="BorderBrush" Value="#F7DCA6"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="Padding" Value="26,13"/>
    </Style>
    <Style x:Key="Brand.Progress" TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource Brand.Accent}"/>
        <Setter Property="Background" Value="#35382F"/>
        <Setter Property="Height" Value="4"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ProgressBar">
                <Grid ClipToBounds="True">
                    <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                    <Border x:Name="PART_Track" Background="Transparent"/>
                    <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2"/>
                    <Rectangle x:Name="Sweep" HorizontalAlignment="Stretch" Fill="{TemplateBinding Foreground}" Visibility="Collapsed"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsIndeterminate" Value="True">
                        <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="Sweep" Property="Visibility" Value="Visible"/>
                    </Trigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions><Condition Property="IsIndeterminate" Value="True"/><Condition Property="IsVisible" Value="True"/><Condition Property="ui:UiAnimation.IsEnabled" Value="True"/></MultiTrigger.Conditions>
                        <MultiTrigger.EnterActions><BeginStoryboard Name="ProgressSweep"><Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="Sweep" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.9" AutoReverse="True"/>
                        </Storyboard></BeginStoryboard></MultiTrigger.EnterActions>
                        <MultiTrigger.ExitActions><StopStoryboard BeginStoryboardName="ProgressSweep"/></MultiTrigger.ExitActions>
                    </MultiTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
</ResourceDictionary>
